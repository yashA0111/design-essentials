---
import RootLayout from "@/layouts/RootLayout.astro";
import { SectionLabel } from "@/components/common/SectionLabel";
---

<RootLayout title="404 - Page Not Found" darkHero={false}>
  <section
    data-theme="light"
    class="section-padding flex min-h-[70vh] items-center bg-[var(--void)] pt-32"
  >
    <div class="container max-w-2xl">
      <SectionLabel className="mb-6">404</SectionLabel>
      <h1 class="text-section mb-6 text-[var(--text-primary)]">
        This page doesn&apos;t exist
      </h1>
      <p class="text-body mb-10">
        The page you were looking for may have moved. Explore our projects and
        services, or get in touch with the studio.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="/projects"
          class="text-nav rounded-full bg-[var(--gold)] px-8 py-3 text-[var(--void)] transition-colors hover:bg-[var(--gold-muted)]"
        >
          View projects
        </a>
        <a
          href="/contact"
          class="text-nav rounded-full border border-[var(--border)] px-8 py-3 text-[var(--text-primary)] transition-colors hover:border-[var(--gold)]"
        >
          Contact us
        </a>
      </div>
    </div>
  </section>
</RootLayout>
