---
import RootLayout from "@/layouts/RootLayout.astro";
import { SITE } from "@/lib/constants";
import { contactPageContent as fallbackContactPageContent } from "@/lib/data/siteContent";
import { getSiteSettings } from "@/lib/sanity";
import { SectionLabel } from "@/components/common/SectionLabel";
import { ContactForm } from "@/components/common/ContactForm";

const settings = await getSiteSettings();
const contactPageContent = {
  ...fallbackContactPageContent,
  ...(settings?.contactPage?.eyebrow ? settings.contactPage : {}),
};
const email = settings?.email || SITE.email;
const phone = settings?.phone || SITE.phone;
const address = settings?.address || SITE.address.full;
const socials = {
  instagram: settings?.instagramUrl || SITE.socials.instagram,
  linkedin: settings?.linkedinUrl || SITE.socials.linkedin,
  behance: settings?.behanceUrl || SITE.socials.behance,
  pinterest: settings?.pinterestUrl || SITE.socials.pinterest,
};
---

<RootLayout
  title={contactPageContent.seo?.title || fallbackContactPageContent.seo.title}
  description={contactPageContent.seo?.description || fallbackContactPageContent.seo.description}
  darkHero={false}
>
  <section
    data-theme="light"
    class="min-h-screen bg-[var(--void)] pt-32 pb-24 lg:pt-40 lg:pb-32"
  >
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16 items-start">
        {/* Left Column: Heading, Intro & Direct Contact Info */}
        <div class="lg:col-span-5">
          <SectionLabel className="mb-6">
            {contactPageContent.eyebrow}
          </SectionLabel>
          
          <h1 class="font-(family-name:--font-display) text-[clamp(36px,4.5vw,56px)] font-light leading-[1.1] text-[var(--text-primary)]">
            {contactPageContent.headingLine1}{" "}
            <em class="font-light italic text-[var(--gold)]">
              {contactPageContent.headingItalic}
            </em>
            <br />
            {contactPageContent.headingLine2}
          </h1>
          
          <p class="text-body mt-6 text-[var(--text-secondary)] text-base leading-relaxed">
            {contactPageContent.intro}
          </p>

          {/* Direct Contact Info */}
          <div class="mt-12 space-y-8 border-t border-[var(--border)] pt-8">
            <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-1">
              <div class="min-w-0">
                <p class="text-eyebrow mb-2 text-[var(--text-tertiary)]">
                  Email
                </p>
                <a
                  href={`mailto:${email}`}
                  class="text-body text-sm text-[var(--text-primary)] transition-colors hover:text-[var(--gold)] break-words [overflow-wrap:anywhere]"
                >
                  {email}
                </a>
              </div>

              <div>
                <p class="text-eyebrow mb-2 text-[var(--text-tertiary)]">
                  Phone
                </p>
                <a
                  href={`tel:${phone.replace(/\s/g, "")}`}
                  class="text-body text-sm text-[var(--text-primary)] transition-colors hover:text-[var(--gold)]"
                >
                  {phone}
                </a>
              </div>

              <div>
                <p class="text-eyebrow mb-2 text-[var(--text-tertiary)]">
                  Studio
                </p>
                <address class="text-body text-sm not-italic text-[var(--text-primary)]">
                  {address}
                </address>
              </div>

              <div>
                <p class="text-eyebrow mb-3 text-[var(--text-tertiary)]">
                  Follow
                </p>
                <div class="flex flex-wrap gap-x-5 gap-y-1">
                  {Object.entries(socials).map(([key, href]) => (
                    <a
                      key={key}
                      href={href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-nav text-xs capitalize text-[var(--text-secondary)] transition-colors hover:text-[var(--gold)]"
                    >
                      {key}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Right Column: Contact Form */}
        <div class="lg:col-span-7">
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>
</RootLayout>
