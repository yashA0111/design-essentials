---
import RootLayout from "@/layouts/RootLayout.astro";
import { blogPageContent } from "@/lib/data/siteContent";
import { getBlogPosts } from "@/lib/sanity";
import { SectionLabel } from "@/components/common/SectionLabel";
import { ImageWithFallback } from "@/components/common/ImageWithFallback";
import { Badge } from "@/components/ui/badge";

const blogPosts = await getBlogPosts();
---

<RootLayout
  title={blogPageContent.seo.title}
  description={blogPageContent.seo.description}
  darkHero={false}
>
  <section data-theme="light" class="section-padding bg-[var(--void)] pt-32">
    <div class="container">
      <SectionLabel className="mb-6">{blogPageContent.eyebrow}</SectionLabel>
      <h1 class="text-section mb-16 text-[var(--text-primary)]">{blogPageContent.title}</h1>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {blogPosts.map((post) => (
          <a
            key={post.id}
            href={`/blog/${post.slug}`}
            class="group border border-[var(--border)] bg-[var(--surface)] transition-colors hover:border-[var(--gold-muted)]"
          >
            <div class="relative aspect-[16/10] overflow-hidden">
              <ImageWithFallback
                src={post.image}
                alt={post.title}
                fill
                sizes="(max-width: 768px) 100vw, 33vw"
                className="transition-transform duration-[var(--dur-base)] group-hover:scale-[1.02]"
              />
            </div>
            <div class="p-6">
              <Badge
                variant="outline"
                className="mb-3 border-[var(--border)] text-[var(--text-secondary)]"
              >
                {post.category}
              </Badge>
              <h2 class="text-card-title mb-3 text-[var(--text-primary)] transition-colors group-hover:text-[var(--gold)]">
                {post.title}
              </h2>
              <p class="text-body mb-4 line-clamp-2 text-sm">
                {post.excerpt}
              </p>
              <div class="flex items-center justify-between">
                <time
                  datetime={post.date}
                  class="text-nav text-[var(--text-tertiary)]"
                >
                  {new Date(post.date).toLocaleDateString("en-IN", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
                <span class="text-nav text-[var(--gold)]">
                  {blogPageContent.readMoreLabel}
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</RootLayout>
