---
import RootLayout from "@/layouts/RootLayout.astro";
import { Check } from "lucide-react";
import { getServices } from "@/lib/sanity";
import { ServiceIcon } from "@/components/common/ServiceIcon";
import { getRelatedProjects } from "@/lib/data/projects";
import { SectionLabel } from "@/components/common/SectionLabel";
import { ImageWithFallback } from "@/components/common/ImageWithFallback";
import { ProjectCard } from "@/components/cards/ProjectCard";
import { ContactCTASection } from "@/components/sections/ContactCTASection";

export async function getStaticPaths() {
  const allServices = await getServices();
  return allServices.map((s) => ({
    params: { slug: s.slug },
    props: { service: s },
  }));
}

const { service } = Astro.props;

if (!service) {
  return Astro.redirect("/404");
}

const relatedProjects = getRelatedProjects(service.id, "", 3);
const galleryImages = [
  { src: service.heroImage, fallback: service.heroImageFallback },
  { src: service.cardImage, fallback: service.cardImageFallback },
];
---

<RootLayout
  title={service.seo.metaTitle}
  description={service.seo.metaDescription}
  darkHero={true}
>
  <section class="relative flex min-h-[60vh] items-end pt-20">
    <div class="absolute inset-0">
      <ImageWithFallback
        src={service.heroImage}
        fallbackSrc={service.heroImageFallback}
        alt={`${service.name} — hero image`}
        fill
        priority
        sizes="100vw"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--void)] via-[var(--void)]/50 to-transparent"></div>
    </div>
    <div class="container relative z-10 section-padding">
      <ServiceIcon
        icon={service.icon}
        className="mb-4 h-8 w-8 text-[var(--gold)]"
        strokeWidth={1.5}
      />
      <h1 class="text-section text-[var(--text-primary)]">
        {service.name}
      </h1>
      <p class="text-body mt-4 max-w-2xl text-lg">{service.tagline}</p>
    </div>
  </section>

  <section data-theme="light" class="section-padding bg-[var(--void)]">
    <div class="container max-w-3xl">
      <SectionLabel className="mb-6">OVERVIEW</SectionLabel>
      <p class="text-body text-lg">{service.description}</p>
    </div>
  </section>

  <section data-theme="light" class="section-padding bg-[var(--surface)]">
    <div class="container">
      <SectionLabel className="mb-6">WHAT WE OFFER</SectionLabel>
      <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {service.features.map((feature) => (
          <li
            key={feature}
            class="flex items-start gap-3 text-[var(--text-secondary)]"
          >
            <Check className="mt-1 h-4 w-4 shrink-0 text-[var(--gold)]" />
            {feature}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section data-theme="light" class="section-padding bg-[var(--void)]">
    <div class="container">
      <SectionLabel className="mb-6">OUR PROCESS</SectionLabel>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        {service.process.map((step) => (
          <div
            key={step.step}
            class="border border-[var(--border)] p-6"
          >
            <span class="font-[family-name:var(--font-display)] text-3xl text-[var(--gold)]">
              {String(step.step).padStart(2, "0")}
            </span>
            <h3 class="text-card-title mt-3 text-[var(--text-primary)]">
              {step.title}
            </h3>
            <p class="text-body mt-2 text-sm">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section data-theme="light" class="section-padding bg-[var(--surface)]">
    <div class="container">
      <SectionLabel className="mb-6">GALLERY</SectionLabel>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {galleryImages.map((image, i) => (
          <div
            key={`${service.id}-gallery-${i}`}
            class="relative aspect-[4/3] overflow-hidden rounded-sm"
          >
            <ImageWithFallback
              src={image.src}
              fallbackSrc={image.fallback}
              alt={`${service.name} gallery image ${i + 1}`}
              fill
              sizes="(max-width: 768px) 100vw, 50vw"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  {relatedProjects.length > 0 && (
    <section data-theme="light" class="section-padding bg-[var(--void)]">
      <div class="container">
        <SectionLabel className="mb-6">RELATED PROJECTS</SectionLabel>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {relatedProjects.map((project) => (
            <ProjectCard key={project.id} project={project} />
          ))}
        </div>
      </div>
    </section>
  )}

  <ContactCTASection client:visible />
</RootLayout>
