# Postgres: use a Vercel/serverless pooled runtime URL. A direct URL can be used only for migrations.
DATABASE_URL=
DATABASE_MIGRATION_URL=
CONTACT_IDEMPOTENCY_SECRET= # 32+ random bytes, rotate only with an idempotency overlap plan
CONTACT_ABUSE_HMAC_SECRET= # HMAC key for non-reversible IP/identity limiter buckets
CONTACT_TOKEN_ENCRYPTION_KEY= # base64 32-byte key; required before enabling Zoho token persistence
CONTACT_PRIVACY_NOTICE_VERSION=v1
CONTACT_RAW_RETENTION_DAYS=90

# Invoke POST /api/cron/contact-pipeline from an external scheduler every 1–5 minutes.
CRON_SECRET=
CONTACT_JOB_BATCH_SIZE=8
CONTACT_WORKER_BUDGET_MS=45000
CONTACT_WORKER_EMAIL_ENABLED=false
CONTACT_WORKER_ZOHO_ENABLED=false
CONTACT_WORKER_FORM2_ENABLED=false

RESEND_API_KEY=
CONTACT_RESEND_FROM=
CONTACT_INTERNAL_RECIPIENT=

# Allowed values: IN, US, EU, AU, JP, CA. Never use arbitrary OAuth/API domains.
ZOHO_DATA_CENTER=IN
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_LEAD_LAYOUT_ID=
ZOHO_PROJECT_DISCOVERY_FIELD=
ZOHO_DEFAULT_COMPANY=Individual – Website Enquiry
ZOHO_LEAD_SOURCE=Website
ZOHO_LEAD_STATUS=Not Contacted

# Form 2 remains externally hosted in V1; URLs must be HTTPS outside development.
FORM2_BASE_URL=
FORM2_TOKEN_TTL_HOURS=168
NEXT_PUBLIC_PRIVACY_POLICY_URL=/privacy
