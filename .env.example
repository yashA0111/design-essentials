# Resend API Key for sending contact form emails (Secret - Do not commit actual key)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Public Sanity CMS Configuration
PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
PUBLIC_SANITY_DATASET=production

# Public Site URL (optional on Vercel deployments, or set your custom domain / vercel app link)
PUBLIC_SITE_URL=https://your-app.vercel.app
